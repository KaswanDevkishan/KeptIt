APP_NAME="KeptIt API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://keptit:keptit@localhost:5432/keptit
CORS_ORIGINS='["http://localhost:5173"]'
SESSION_COOKIE_NAME=keptit_session
# Local HTTP only. Production must set this to true and serve exclusively over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
SESSION_DURATION_SECONDS=2592000
# Reset tokens are placed in the URL fragment so they are not sent in HTTP referrers or requests.
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_LIFETIME_SECONDS=1800
# Development only. Production must use a future real provider implementation.
EMAIL_BACKEND=development_file
DEVELOPMENT_EMAIL_OUTBOX_PATH=.local/password-reset-outbox.jsonl
# Metadata enrichment (provider keys are optional; never expose them to the frontend)
METADATA_CONNECT_TIMEOUT_SECONDS=3
METADATA_READ_TIMEOUT_SECONDS=5
METADATA_MAX_RESPONSE_BYTES=1000000
METADATA_MAX_REDIRECTS=3
METADATA_USER_AGENT="KeptIt-Metadata/1.0 (+https://keptit.example)"
YOUTUBE_API_KEY=
# Change to a long random secret in production; signs opaque Space pagination cursors.
SPACES_CURSOR_SECRET=development-only-spaces-cursor-secret

# Optional manual AI summaries. Fake mode needs no network or key.
AI_SUMMARIES_ENABLED=false
AI_REAL_PROVIDER_ENABLED=false
AI_SUMMARY_PROVIDER=fake
OPENAI_API_KEY=
AI_SUMMARY_MODEL=gpt-4.1-mini
AI_SUMMARY_PROMPT_VERSION=ai-summary-v1
AI_SUMMARY_TIMEOUT_SECONDS=15
AI_SUMMARY_MAX_INPUT_CHARS=6000
AI_SUMMARY_MAX_OUTPUT_TOKENS=800
AI_SUMMARY_DAILY_LIMIT=20
AI_SUMMARY_CONCURRENT_LIMIT=2
AI_SUMMARY_REGENERATION_COOLDOWN_SECONDS=60
AI_SUMMARY_MAX_RETRIES=2
# Configurable minor-unit rates per token; leave blank to store null estimates.
AI_SUMMARY_COST_INPUT_RATE=
AI_SUMMARY_COST_OUTPUT_RATE=
AI_SUMMARY_FAKE_BEHAVIOR=success
